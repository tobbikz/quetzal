# Postgres (schema quetzal). Host default matches local peer auth user.
QUETZAL_DATABASE_URL=postgresql://tomy.berrios@127.0.0.1:5432/quetzal

# Docker Compose overrides (see docker-compose.yml):
# QUETZAL_DATABASE_URL=postgresql://quetzal:quetzal@db:5432/quetzal
# QUETZAL_PG_PASSWORD=quetzal
# QUETZAL_PG_PORT=5433
# QUETZAL_APP_PORT=3210

# Public origin (CSAT + notify absolute links) — no trailing slash
# QUETZAL_BASE_URL=https://desk.example.com

# Auth
# Seed empty local users with password "quetzal" (set 0 to skip)
# QUETZAL_SEED_PASSWORDS=1
# Allow passwordless quick-login buttons on /login (dev only; ignored in production)
# QUETZAL_QUICK_LOGIN=0
# Accept any password when user has no hash (dev only; ignored in production)
# QUETZAL_DEMO_AUTH=0

# Notifications (env wins over Settings → Notifications when set)
# QUETZAL_SMTP_HOST=
# QUETZAL_SMTP_PORT=587
# QUETZAL_SMTP_USER=
# QUETZAL_SMTP_PASS=
# QUETZAL_SMTP_FROM=
# QUETZAL_SLACK_WEBHOOK=

# GitHub outbound comments (repo scope PAT)
# QUETZAL_GITHUB_TOKEN=

# Cron: POST /api/automation/tick
# QUETZAL_AUTOMATION_CRON_SECRET=
