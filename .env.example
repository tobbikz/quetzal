# Copy to .env (never commit .env)

# --- Compose / Postgres ---
QUETZAL_PG_PASSWORD=change-me-strong
QUETZAL_PG_PORT=5433
QUETZAL_APP_PORT=3210
QUETZAL_DATABASE_URL=postgresql://tomy.berrios@127.0.0.1:5432/quetzal

# Public origin for CSAT + notify links (no trailing slash)
QUETZAL_BASE_URL=http://127.0.0.1:3210

# Required for Compose cron → POST /api/automation/tick
QUETZAL_AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Seed local demo passwords on first boot (Compose). Always "0" for hardened hosts after seed.
QUETZAL_SEED_PASSWORDS=1

# Auth escapes — must stay 0/unset in production (Compose forces 0)
QUETZAL_DEMO_AUTH=0
QUETZAL_QUICK_LOGIN=0

# GitHub outbound comments (create a NEW fine-grained PAT; never reuse a leaked one)
# Permissions: Issues + Pull requests Read/Write on target repos
QUETZAL_GITHUB_TOKEN=

# SMTP — Compose defaults to Mailpit (host mail:1025). For real providers set these:
# QUETZAL_SMTP_HOST=smtp.example.com
# QUETZAL_SMTP_PORT=587
# QUETZAL_SMTP_USER=
# QUETZAL_SMTP_PASS=
# QUETZAL_SMTP_FROM=desk@example.com
QUETZAL_SMTP_FROM=quetzal@localhost

# Optional Slack
# QUETZAL_SLACK_WEBHOOK=
